---
layout: layouts/base.njk
title: All posts
description: Every entry in the diary, newest first.
permalink: "/posts/"
---
{%- set list = collections.diary %}
<header class="page-head">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="{{ '/' | url }}">Diary</a><span class="sep" aria-hidden="true">/</span><span>All posts</span>
  </nav>
  <h1 class="page-title">All posts</h1>
  <p class="page-lead">Every entry, newest first. {{ list.length }} {{ "entry" if list.length == 1 else "entries" }} across {{ categories.length }} {{ "category." if categories.length == 1 else "categories." }}</p>
</header>

<nav class="chips" aria-label="Categories">
  <a class="chip" href="{{ '/posts/' | url }}" aria-current="page">All</a>
  {%- for c in categories %}
  <a class="chip" href="{{ ('/category/' + c.slug + '/') | url }}">{{ c.title }}</a>
  {%- endfor %}
</nav>

<div class="years">
{%- for g in list | byYear %}
  <section class="year-group">
    <h2 class="year">{{ g.year }}</h2>
    <ul class="table">
    {%- for p in g.posts %}
      {%- set c = categories | catBySlug(p.data.category) %}
      <li>
        <a class="trow" href="{{ p.url | url }}">
          <span class="t-date">{{ p.date | fmtDate }}</span>
          <span class="t-main">
            <span class="t-title">{{ p.data.title }}</span>
            {%- if p.data.summary %}
            <span class="t-sum">{{ p.data.summary }}</span>
            {%- endif %}
            <span class="t-cat">{{ c.title }}</span>
          </span>
          <span class="t-read">{{ p.data.read }} min</span>
        </a>
      </li>
    {%- endfor %}
    </ul>
  </section>
{%- else %}
  <p class="note">No entries yet.</p>
{%- endfor %}
</div>
